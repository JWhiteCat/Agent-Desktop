{
  "name": "agent-desktop",
  "productName": "Agent Desktop",
  "desktopName": "dev.agentdesktop.app.desktop",
  "version": "0.1.0",
  "description": "A desktop client for Cursor CLI, Codex CLI, and Claude Code with multi-project history",
  "homepage": "https://github.com/JWhiteCat/Agent-Desktop",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:linux": "bash scripts/start-linux.sh dev",
    "dev:mac": "bash scripts/start-mac.sh dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "preview:linux": "bash scripts/start-linux.sh preview",
    "preview:mac": "bash scripts/start-mac.sh preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && npm run typecheck:tests",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "icons": "electron scripts/render-icons.cjs",
    "setup:public-server": "node scripts/setup-public-server.mjs",
    "release": "node scripts/release.mjs",
    "test:live": "vitest run --config vitest.live.config.ts",
    "dist": "electron-vite build && electron-builder",
    "dist:win:portable": "electron-vite build && electron-builder --win portable --x64 --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --x64 --publish never",
    "dist:linux:dir": "electron-vite build && electron-builder --linux --x64 --dir --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac dmg --publish never",
    "dist:mac:arm64": "electron-vite build && electron-builder --mac dmg --arm64 --publish never",
    "dist:mac:x64": "electron-vite build && electron-builder --mac dmg --x64 --publish never",
    "dist:mac:dir": "electron-vite build && electron-builder --mac --dir --publish never",
    "verify:mac": "node scripts/verify-mac.mjs"
  },
  "build": {
    "appId": "dev.agentdesktop.app",
    "productName": "Agent Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/icons/**/*",
      "node_modules/@agentclientprotocol/codex-acp/**/*",
      "node_modules/@openai/codex/**/*",
      "node_modules/@openai/codex-*/**/*",
      "node_modules/@agentclientprotocol/claude-agent-acp/**/*",
      "node_modules/@agentclientprotocol/sdk/**/*",
      "node_modules/@anthropic-ai/claude-agent-sdk/**/*",
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**/*",
      "node_modules/zod/**/*"
    ],
    "asarUnpack": [
      "node_modules/@agentclientprotocol/codex-acp/**/*",
      "node_modules/@openai/codex/**/*",
      "node_modules/@openai/codex-*/**/*",
      "node_modules/@agentclientprotocol/claude-agent-acp/**/*",
      "node_modules/@agentclientprotocol/sdk/**/*",
      "node_modules/@anthropic-ai/claude-agent-sdk/**/*",
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**/*",
      "node_modules/zod/**/*"
    ],
    "extraResources": [
      { "from": "out/main/toolbar-runner.cjs", "to": "toolbar-runner.cjs" }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icons/icon.ico"
    },
    "portable": {
      "artifactName": "${name}-${version}-win-${arch}-portable.${ext}",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "artifactName": "${name}-${version}-win-${arch}-setup.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/icons/icon.icns",
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "13.0",
      "artifactName": "${name}-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Agent Desktop uses Terminal to run the commands you choose from the toolbar."
      }
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "executableName": "agent-desktop",
      "icon": "resources/icons",
      "extraFiles": [
        { "from": "scripts/linux-appimage-apprun.sh", "to": "AppRun" }
      ],
      "category": "Development",
      "synopsis": "Desktop client for AI coding agents",
      "maintainer": "JWhiteCat <wanjian@njust.edu.cn>",
      "artifactName": "${name}-${version}-linux-${arch}.${ext}",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Keywords": "AI;Coding;Cursor;Codex;Claude;",
          "StartupNotify": "true"
        }
      }
    },
    "appImage": {
      "executableArgs": []
    }
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.81.2",
    "@agentclientprotocol/codex-acp": "^1.13.1",
    "cross-spawn": "^7.0.6",
    "js-tiktoken": "1.0.21",
    "mermaid": "^12.2.0",
    "micromark-core-commonmark": "2.0.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.13.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "js-yaml": "4.3.2",
    "micromark-util-types": "2.0.2",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  }
}
