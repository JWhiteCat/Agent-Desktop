{
  "name": "agent-desktop",
  "productName": "Agent Desktop",
  "version": "0.1.0",
  "description": "A desktop client for Cursor CLI, Codex CLI, and Claude Code with multi-project history",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "setup:public-server": "node scripts/setup-public-server.mjs",
    "test:live": "vitest run --config vitest.live.config.ts",
    "dist": "electron-vite build && electron-builder"
  },
  "build": {
    "appId": "dev.agentdesktop.app",
    "productName": "Agent Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "node_modules/@agentclientprotocol/codex-acp/**/*",
      "node_modules/@openai/codex/**/*",
      "node_modules/@openai/codex-*/**/*",
      "node_modules/@agentclientprotocol/claude-agent-acp/**/*",
      "node_modules/@agentclientprotocol/sdk/**/*",
      "node_modules/@anthropic-ai/claude-agent-sdk/**/*",
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**/*",
      "node_modules/zod/**/*"
    ],
    "asarUnpack": [
      "node_modules/@agentclientprotocol/codex-acp/**/*",
      "node_modules/@openai/codex/**/*",
      "node_modules/@openai/codex-*/**/*",
      "node_modules/@agentclientprotocol/claude-agent-acp/**/*",
      "node_modules/@agentclientprotocol/sdk/**/*",
      "node_modules/@anthropic-ai/claude-agent-sdk/**/*",
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**/*",
      "node_modules/zod/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.81.2",
    "@agentclientprotocol/codex-acp": "^1.13.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  }
}
